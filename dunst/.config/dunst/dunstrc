[global]
    # Font & text
    font = Hack 11
    markup = full
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    ignore_newline = no
    line_height = 0

    # Placement & size (replaces old geometry)
    width = (0, 300)
    origin = top-right
    offset = (6, 30)
    follow = mouse
    alignment = center
    show_age_threshold = 60

    # Behavior & history
    sort = yes
    indicate_hidden = yes
    notification_limit = 5
    idle_threshold = 120
    sticky_history = yes
    history_length = 20

    # Spacing & frame
    padding = 8
    horizontal_padding = 8
    gap_size = 8
    separator_height = 2
    frame_width = 3
    frame_color = "#3c3836"
    separator_color = frame
    corner_radius = 0

    # Progress bar (volume/brightness etc.)
    progress_bar = yes
    progress_bar_height = 10
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_frame_width = 1
    progress_bar_corner_radius = 0

    # External integration
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

[urgency_low]
    # Subtle: gray text, frame blends into bg, quick timeout
    background = "#1d2021"
    foreground = "#a89984"
    highlight = "#689d6a"
    frame_color = "#1d2021"
    timeout = 4

[urgency_normal]
    # Default look: gruvbox fg, mild frame
    background = "#1d2021"
    foreground = "#d5c4a1"
    highlight = "#83a598"
    timeout = 6

[urgency_critical]
    # Standout: red fg + red frame, never auto-times out
    background = "#1d2021"
    foreground = "#fb4934"
    highlight = "#fb4934"
    frame_color = "#fb4934"
    timeout = 0
